# GEMINI_API_KEY: Required for Gemini AI API calls (Server-Side Only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Brevo Transactional HTTPS REST API Configuration (Server-Side Only — Never expose to VITE_*)
# POST https://api.brevo.com/v3/smtp/email (Default Verified Sender: srterminalofficial@gmail.com)
BREVO_API_KEY=your_brevo_v3_api_key_xkeysib
BREVO_SENDER_EMAIL=srterminalofficial@gmail.com
BREVO_SENDER_NAME="SR Terminal"

# Server-Side TwelveData Market Feed API Key (Never expose to VITE_*)
TWELVEDATA_API_KEY=

# Session HMAC Secret (Server-Side Only)
SESSION_SECRET=
